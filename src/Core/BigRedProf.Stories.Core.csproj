<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>

		<Title>Stories Library</Title>
		<Description>Stories capture a series of things over time.</Description>
		<PackageTags>bigredprof;stories;event-sourcing;append-only;signalr</PackageTags>
		<Product>Stories Library</Product>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />
		<PackageReference Include="System.Net.Http.Json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core.Models\BigRedProf.Stories.Core.Models.csproj" />
	</ItemGroup>

</Project>
