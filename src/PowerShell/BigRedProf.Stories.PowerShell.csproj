<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>BigRedProf.Stories.PowerShell</AssemblyName>
		<RootNamespace>BigRedProf.Stories.PowerShell</RootNamespace>

		<!--
		SPIKE. Not published yet: the packaging question (PowerShell Gallery, and
		what the module is actually called) is still open on stories#5. This exists
		to answer the risk that issue flagged first: whether a binary module
		carrying the SignalR dependency tree loads cleanly in pwsh 7 at all.
		-->
		<IsPackable>false</IsPackable>

		<!--
		Emits a .deps.json and lays out dependencies so the assembly can be loaded
		as a PLUGIN rather than as an application. Without it, Import-Module resolves
		only what the host already happens to have loaded, which is exactly how a
		binary module ends up with a missing assembly error at first use rather than
		at import.
		-->
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>

	<ItemGroup>
		<!--
		A REFERENCE assembly for System.Management.Automation. PrivateAssets keeps
		it out of the output: the PowerShell host supplies the real implementation,
		and shipping our own copy is a reliable way to break a module.
		-->
		<PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
	</ItemGroup>

	<!--
	The module has its OWN version line, independent of the four library packages
	(stories#5). Two version lines in one repository means two tag prefixes: the
	libraries release on `v*`, this module on `psmodule-v*`. Without the override it
	would inherit `v` from Directory.Build.props, and every library release would
	drag the module along, silently undoing the decision.
	-->
	<PropertyGroup>
		<MinVerTagPrefix>psmodule-v</MinVerTagPrefix>
		<MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\BigRedProf.Stories.Core.csproj" />
	</ItemGroup>

	<!--
	Writes the MinVer-computed version beside the assembly so the packaging script
	can read it without reflection or FileVersionInfo. Both of those are awkward
	across platforms, and CI stages this module on Linux; a plain text file reads
	the same everywhere and cannot disagree with the binary it sits next to.
	-->
	<Target Name="WriteModuleVersion" AfterTargets="Build">
		<WriteLinesToFile
			File="$(OutDir)module-version.txt"
			Lines="$(Version)"
			Overwrite="true"
			WriteOnlyWhenDifferent="true" />
	</Target>

</Project>
