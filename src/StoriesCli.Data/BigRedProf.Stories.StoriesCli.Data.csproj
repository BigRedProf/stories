<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>

		<Title>Stories CLI Data</Title>
		<Description>The schema declarations and durable vocabulary for BigRedProf.Stories.StoriesCli.</Description>
		<Product>Stories CLI Data</Product>


		<!-- Schema declarations for the tape CLI, which is not published as a package today. -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
	The generated files do not exist when MSBuild evaluates this project, so a
	Compile glob here is empty on a clean build: prc writes them, then the
	compiler never sees them, and the assembly has no [AssemblyRegistrationHelper].
	Add them from the target that generates them, before CoreCompile.
	-->
	<Target Name="RunPackRatCompiler" BeforeTargets="CoreCompile" Condition="'$(PackRatCompilerRunning)' != 'true'">
		<!--
		prc builds this project to read it. Without the guard, that inner build
		runs this target and starts prc again.
		-->
		<Exec
			WorkingDirectory="$(ProjectDir)"
			Command="dotnet prc $(ProjectFileName) -o $(IntermediateOutputPath)"
			EnvironmentVariables="PackRatCompilerRunning=true"
			ContinueOnError="false"
			ConsoleToMSBuild="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="OutputOfExec" />
		</Exec>
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)*.g.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <Folder Include="obj\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="BigRedProf.Data.Core" />
	</ItemGroup>

</Project>
