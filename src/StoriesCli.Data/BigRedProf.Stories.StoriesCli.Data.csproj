<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>

		<Title>Stories CLI Data</Title>
		<Description>The schema declarations and durable vocabulary for BigRedProf.Stories.StoriesCli.</Description>
		<Product>Stories CLI Data</Product>


		<!-- Schema declarations for the tape CLI, which is not published as a package today. -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<Target Name="RunPackRatCompiler" BeforeTargets="Build">
		<Exec WorkingDirectory="$(ProjectDir)" Command="dotnet prc $(ProjectFileName) -o $(IntermediateOutputPath)" ContinueOnError="false" ConsoleToMSBuild="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="OutputOfExec" />
		</Exec>
	</Target>

	<ItemGroup>
		<Compile Include="$(IntermediateOutputPath)\*.g.cs"></Compile>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="obj\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="BigRedProf.Data.Core" />
	</ItemGroup>

</Project>
